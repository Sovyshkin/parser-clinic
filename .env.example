TELEGRAM_BOT_TOKEN=
SEARCH_API_KEY=
ADMIN_TELEGRAM_IDS=

# Recommended provider: Brave Search API.
SEARCH_PROVIDER=brave
BRAVE_COUNTRY=ru
BRAVE_SEARCH_LANG=ru

# Options below are only used when SEARCH_PROVIDER=json.
SEARCH_API_URL=
SEARCH_ENGINE_ID=
SEARCH_API_KEY_PARAM=key
SEARCH_API_KEY_HEADER=
SEARCH_QUERY_PARAM=q
SEARCH_LIMIT_PARAM=num
SEARCH_START_PARAM=start

CONCURRENCY=3
REQUEST_TIMEOUT=20
REQUEST_RETRIES=2
MIN_DELAY=0.7
MAX_DELAY=1.8
MAX_PAGES_PER_SITE=5
PLAYWRIGHT_ENABLED=true
EXCLUDED_DOMAINS=
